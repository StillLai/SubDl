  "rules": [
    {
      "action": "sniff"
    },
    {
      "type": "logical",
      "mode": "or",
      "rules": [
        {
          "protocol": "dns"
        },
        {
          "port": 53
        }
      ],
      "action": "hijack-dns"
    },
    {
      "type": "logical",
      "mode": "or",
      "rules": [
        {
          "ip_is_private": true
        },
        {
          "rule_set": [
            "geosite-private",
            "geoip-private"
          ]
        }
      ],
      "outbound": "🎯 全球直连"
    },
    {
      "type": "logical",
      "mode": "or",
      "rules": [
        {
          "port": 853
        },
        {
          "network": "udp",
          "port": 443
        },
        {
          "protocol": "stun"
        }
      ],
      "action": "reject"
    },
    {
      "clash_mode": "Direct",
      "outbound": "🎯 全球直连"
    },
    {
      "type": "logical",
      "mode": "or",
