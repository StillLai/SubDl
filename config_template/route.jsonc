    "rules": [
      { // 流量嗅探
        "action": "sniff"
      },
      { // DNS 劫持
        "type": "logical",
        "mode": "or",
        "rules": [
          {"protocol": "dns"},
          {"port": 53}
        ],
        "action": "hijack-dns"
      },
      { // 私有网络直连
        "type": "logical",
        "mode": "or",
        "rules": [
          {"ip_is_private": true},
          {"rule_set": ["geosite-private", "geoip-private"]}
        ],
        "outbound": "🎯 全球直连"
      },
      { // 拒绝 DoT/QUIC/STUN
        "type": "logical",
        "mode": "or",
        "rules": [
          {"port": 853},
          {"network": "udp", "port": 443},
          {"protocol": "stun"}
        ],
        "action": "reject"
      },
      { // 直连模式
        "clash_mode": "Direct",
        "outbound": "🎯 全球直连"
      },
      { // 全局模式
        "type": "logical",
        "mode": "or",
        "rules": [
          {"clash_mode": "Global"},
          {"inbound": "mixed-in-global"}
        ],
        "outbound": "Global"
      },
      { // 广告拦截
        "type": "logical",
        "mode": "and",
        "rules": [
          {"clash_mode": "AlwAds", "invert": true},
          {"rule_set": ["custom_whitelist", "geosite-amazon", "geosite-amazon@ads"], "invert": true},
          {"rule_set": ["ads", "custom_block", "WebRTC"]}
        ],
        "action": "reject"
      },
      { // 银行APP（工商/建设/农业/中国/交通/招商）
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-icbc", "geosite-ccb", "geosite-abc", "geosite-boc", "BOCOM", "geosite-cmb"]},
          {"package_name": ["com.icbc", "com.chinamworld.main", "com.android.bankabc", "com.chinamworld.bocmbci", "com.bankcomm.Bankcomm", "com.cmbchina.ccd.pluto.cmbActivity", "cmb.pb"]}
        ],
        "outbound": "🎯 全球直连"
      },
      { // 亚马逊
        "rule_set": ["geosite-amazon", "geosite-amazon@ads"],
        "outbound": "🅰️ 亚马逊"
      },
      { // Jav
        "type": "logical",
        "mode": "or",
        "rules": [
          {"domain": ["javdb.com", "jdbstatic.com", "jav.app"]},
          {"domain_keyword": ["javbus"]},
          {"package_name": ["xxx.pornhub.fuck"]}
        ],
        "outbound": "🔞 版权内容"
      },
      { // 微信
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["WeChat"]},
          {"package_name": ["com.tencent.mm"]}
        ],
        "outbound": "🟢 微信"
      },
      { // 支付宝
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["AliPay"]},
          {"package_name": ["com.eg.android.AlipayGphone"]}
        ],
        "outbound": "🟦 支付宝"
      },
      { // 哔哩哔哩
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["BiliBili"]},
          {"package_name": ["tv.danmaku.bili"]}
        ],
        "outbound": "📺 哔哩哔哩"
      },
      { // 抖音
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-douyin"]},
          {"package_name": ["com.ss.android.ugc.aweme"]}
        ],
        "outbound": "🎵 抖音"
      },
      { // 微博
        "rule_set": ["Weibo"],
