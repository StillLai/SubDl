        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "geosite-google",
              "geoip-google",
              "geosite-google-play"
            ]
          },
          {
            "package_name": [
              "com.android.vending",
              "com.google.android.gms",
              "com.google.android.gsf",
              "com.google.android.onetimeinitializer"
            ]
          }
        ],
        "outbound": "🇬 Google"
      },
      {
        "rule_set": [
          "geosite-geolocation-cn",
          "custom_direct"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "geosite-geolocation-!cn",
              "custom_proxy"
            ],
            "invert": true
          },
          {
            "rule_set": "geoip-cn"
          }
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn",
          "custom_proxy"
        ],
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": [
          "geosite-tld-cn",
          "GeositeCN",
          "geoip-cn"
        ],
        "outbound": "🎯 全球直连"
      }
    ],
    "final": "🐟 漏网之鱼"
  }
}
