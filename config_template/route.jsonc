{
  "$schema": "https://ghfast.top/https://github.com/StillLai/SubDl/raw/refs/heads/main/sing-box-reF1nd-docs/schema.json",
  "route": {
    "default_domain_resolver": "Ali-DNS",
    "default_http_client": "走直连下载",
    "auto_detect_interface": true,
    "find_process": true,
    "rule_set": [
      // 自定义规则集（tag 即文件名，3h 更新）
      {
        "tag": ["custom_whitelist", "custom_block", "custom_direct", "custom_proxy"],
        "type": "remote",
        "url": "https://ghfast.top/https://github.com/StillLai/SubDl/releases/download/ruleset-srs/{tag}.srs",
        "update_interval": "3h"
      },
      // 自托管规则集（tag 即文件名，6h 更新）
      {
        "tag": ["WebRTC", "BOCOM", "WeChat", "AliPay", "BiliBili", "Weibo", "Apple", "XiaoMi", "GeositeCN"],
        "type": "remote",
        "url": "https://ghfast.top/https://github.com/StillLai/SubDl/releases/download/ruleset-srs/{tag}.srs",
        "update_interval": "6h"
      },
      // AWAvenue 广告规则（文件名与 tag 不一致，不适用 {tag} 占位符）
      {
        "tag": "ads",
        "type": "remote",
        "url": "https://ghfast.top/https://github.com/StillLai/SubDl/releases/download/ruleset-srs/AWAvenue-Ads-Rule-Singbox.srs",
        // "url": "https://anti-ad.net/anti-ad-sing-box.srs",
        "update_interval": "6h"
      },
      // fakeip 过滤
      {
        "tag": "fakeip-filter",
        "type": "remote",
        "url": "https://ghfast.top/https://github.com/DustinWin/ruleset_geodata/raw/refs/heads/sing-box-ruleset/fakeip-filter.srs",
        "update_interval": "6h"
      },
      // MetaCubeX geosite / geoip（tag 即源站路径）
      {
        "tag": [
          "geosite/amazon",
          "geosite/amazon@ads",
          "geosite/icbc",
          "geosite/ccb",
          "geosite/abc",
          "geosite/boc",
          "geosite/cmb",
          "geosite/douyin",
          "geosite/xiaohongshu",
          "geosite/category-game-accelerator-cn",
          "geosite/steam",
          "geosite/ubisoft",
          "geosite/epicgames",
          "geosite/tailscale",
          "geosite/github",
          "geosite/youtube",
          "geosite/netflix",
          "geoip/netflix",
          "geosite/tiktok",
          "geosite/spotify",
          "geosite/telegram",
          "geoip/telegram",
          "geosite/twitter",
          "geoip/twitter",
          "geosite/facebook",
          "geoip/facebook",
          "geosite/discord",
          "geosite/openai",
          "geosite/cloudflare",
          "geoip/cloudflare",
          "geosite/google-play",
          "geosite/google",
          "geoip/google",
          "geosite/microsoft",
          "geosite/private",
          "geoip/private",
          "geosite/geolocation-!cn",
          "geosite/geolocation-cn",
          "geosite/tld-cn",
          "geoip/cn"
        ],
        "type": "remote",
        "url": "https://ghfast.top/https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/{tag}.srs",
        "update_interval": "6h"
      }
    ],
    "rules": [
      { // 流量嗅探
        "action": "sniff"
      },
      { // DNS 劫持
        "type": "logical",
        "mode": "or",
        "rules": [
          {"protocol": "dns"},
          {"port": 53}
        ],
        "action": "hijack-dns"
      },
      { // Tailscale
        "type": "logical",
        "mode": "or",
        "rules": [
          {"domain_suffix": ["ts.net", "100.in-addr.arpa"]},
          {"ip_cidr": ["100.64.0.0/10", "fd7a:115c:a1e0::/48"]}
        ],
        "outbound": "ts-ep"
      },
      { // 私有网络直连
        "type": "logical",
        "mode": "or",
        "rules": [
          {"ip_is_private": true},
          {"rule_set": ["geosite/private", "geoip/private"]},
          {"port": 3389}
        ],
        "outbound": "🎯 全球直连"
      },
      { // 拒绝 DoT/STUN/QUIC
        "type": "logical",
        "mode": "or",
        "rules": [
          {"port": 853},
          {"protocol": "stun"},
          {"network": "udp", "port": 443}
        ],
        "action": "reject"
      },
      { // 直连模式
        "clash_mode": "Direct",
        "outbound": "🎯 全球直连"
      },
      { // 全局模式
        "type": "logical",
        "mode": "or",
        "rules": [
          {"clash_mode": "Global"},
          {"inbound": "mixed-in-global"}
        ],
        "outbound": "GLOBAL"
      },
      { // 广告拦截
        "type": "logical",
        "mode": "and",
        "rules": [
          {"clash_mode": "AlwAds", "invert": true},
          {"rule_set": ["custom_whitelist", "geosite/amazon", "geosite/amazon@ads"], "invert": true},
          {"rule_set": ["ads", "custom_block", "WebRTC"]}
        ],
        "action": "reject"
      },
      { // 银行APP（工商/建设/农业/中国/交通/招商）、雅迪智行
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/icbc", "geosite/ccb", "geosite/abc", "geosite/boc", "BOCOM", "geosite/cmb"]},
          {"package_name": ["com.icbc", "com.chinamworld.main", "com.android.bankabc", "com.chinamworld.bocmbci", "com.bankcomm.Bankcomm", "com.cmbchina.ccd.pluto.cmbActivity", "cmb.pb", "com.yadea.smartmoto"]},
          {"domain_suffix": ["yadeaiot.com.cn"]}
        ],
        "outbound": "🎯 全球直连"
      },
      { // fakeip-filter
        "type": "logical",
        "mode": "and",
        "rules": [
          {"rule_set": ["fakeip-filter"]},
          {"domain_suffix": ["steamcontent.com"], "invert": true}
        ],
        "outbound": "🎯 全球直连"
      },
      { // 加速器
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/category-game-accelerator-cn"]},
          {"process_name": ["Steamcommunity_302.exe"]}
        ],
        "outbound": "🎯 全球直连"
      },
      { // Steam-全平台
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/steam"]},
          {"package_name": ["com.valvesoftware.android.steam.community"]},
          {"process_path_regex": [".+?\\\\Steam(?:\\\\[^\\\\]+)*\\\\[^\\\\]*[Ss]team[^\\\\]*\\.exe"]}
        ],
        "outbound": "🎮 Steam"
      },
      { // Epic Games
        "rule_set": ["geosite/epicgames"],
        "outbound": "🎁 Epic"
      },
      { // 育碧
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/ubisoft"]},
          {"process_path_regex": [".+?\\\\Ubisoft\\\\Ubisoft Game Launcher(?: Core)?(?:\\\\[^\\\\]+)*\\\\[^\\\\]+\\.exe"]}
        ],
        "outbound": "🌀 育碧"
      },
      { // DNS测试
        "domain_suffix": ["browserleaks.com", "browserleaks.org", "browserleaks.net", "ipleak.net", "dnsleaktest.com"],
        "outbound": "🔍 DNS测试"
      },
      { // 亚马逊
        "rule_set": ["geosite/amazon", "geosite/amazon@ads"],
        "outbound": "🅰️ 亚马逊"
      },
      { // Jav
        "type": "logical",
        "mode": "or",
        "rules": [
          {"domain": ["javdb.com", "jdbstatic.com", "jav.app"]},
          {"domain_keyword": ["javbus"]},
          {"package_name": ["xxx.pornhub.fuck"]}
        ],
        "outbound": "🔞 版权内容"
      },
      { // Tailscale
        "rule_set": ["geosite/tailscale"],
        "outbound": "🔗 Tailscale"
      },
      { // 微信
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["WeChat"]},
          {"package_name": ["com.tencent.mm"]}
        ],
        "outbound": "🟢 微信"
      },
      { // 支付宝
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["AliPay"]},
          {"package_name": ["com.eg.android.AlipayGphone"]}
        ],
        "outbound": "🟦 支付宝"
      },
      { // 哔哩哔哩
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["BiliBili"]},
          {"package_name": ["tv.danmaku.bili"]}
        ],
        "outbound": "📺 哔哩哔哩"
      },
      { // 抖音
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/douyin"]},
          {"package_name": ["com.ss.android.ugc.aweme"]}
        ],
        "outbound": "🎵 抖音"
      },
      { // 微博
        "rule_set": ["Weibo"],
        "outbound": "👁️ 微博"
      },
      { // 小红书
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/xiaohongshu"]},
          {"package_name": ["com.xingin.xhs"]}
        ],
        "outbound": "🍠 小红书"
      },
      { // GitHub
        "rule_set": ["geosite/github"],
        "outbound": "🐱 GitHub"
      },
      { // YouTube
        "rule_set": ["geosite/youtube"],
        "outbound": "📹 YouTube"
      },
      { // Netflix
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/netflix", "geoip/netflix"]},
          {"package_name": ["com.netflix.mediaclient"]}
        ],
        "outbound": "🎥 Netflix"
      },
      { // TikTok
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/tiktok"]},
          {"package_name": ["com.zhiliaoapp.musically"]}
        ],
        "outbound": "🎶 TikTok"
      },
      { // Spotify
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/spotify"]},
          {"package_name": ["com.spotify.music"]}
        ],
        "outbound": "💚 Spotify"
      },
      { // Telegram
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/telegram", "geoip/telegram"]},
          {"package_name": ["nekox.messenger", "org.telegram.messenger", "tw.nekomimi.nekogram", "xyz.nextalone.nagram"]}
        ],
        "outbound": "✈️ Telegram"
      },
      { // Twitter(X)
        "rule_set": ["geosite/twitter", "geoip/twitter"],
        "outbound": "🐦 Twitter(X)"
      },
      { // Facebook
        "rule_set": ["geosite/facebook", "geoip/facebook"],
        "outbound": "👍 Facebook"
      },
      { // Discord
        "rule_set": ["geosite/discord"],
        "outbound": "💬 Discord"
      },
      { // OpenAI
        "rule_set": ["geosite/openai"],
        "outbound": "🤖 OpenAI"
      },
      { // 小米
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["XiaoMi"]},
          {"package_name": ["com.xiaomi.smarthome", "com.xiaomi.vipaccount"]}
        ],
        "outbound": "📱 小米"
      },
      { // Apple
        "rule_set": ["Apple"],
        "outbound": "🍎 Apple"
      },
      { // Microsoft
        "rule_set": ["geosite/microsoft"],
        "outbound": "🪟 Microsoft"
      },
      { // Cloudflare
        "rule_set": ["geosite/cloudflare", "geoip/cloudflare"],
        "outbound": "☁️ Cloudflare"
      },
      { // Google 服务
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite/google", "geoip/google", "geosite/google-play"]},
          {"package_name": ["com.android.vending", "com.google.android.gms", "com.google.android.gsf", "com.google.android.onetimeinitializer"]}
        ],
        "outbound": "🇬 Google"
      },
      { // 国内网站
        "rule_set": ["geosite/geolocation-cn", "custom_direct"],
        "outbound": "🎯 全球直连"
      },
      { // 国内IP（排除海外）
        "type": "logical",
        "mode": "and",
        "rules": [
          {"rule_set": ["geosite/geolocation-!cn", "custom_proxy"], "invert": true},
          {"rule_set": ["geoip/cn"]}
        ],
        "outbound": "🎯 全球直连"
      },
      { // 海外网站
        "rule_set": ["geosite/geolocation-!cn", "custom_proxy"],
        "outbound": "🚀 节点选择"
      },
      { // CN域名/IP
        "rule_set": ["geosite/tld-cn", "GeositeCN", "geoip/cn"],
        "outbound": "🎯 全球直连"
      }
    ],
    "final": "🐟 漏网之鱼"
  }
}