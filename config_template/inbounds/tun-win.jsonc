{
  "$schema": "https://ghfast.top/https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "net9",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      // "route_exclude_address": [
      //   "100.64.0.0/10"  // tailscale
      // ],
      "mtu": 1500,
      "stack": "system",
      "strict_route": true,
      "auto_route": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 5297
    },
    {
      "type": "mixed",
      "tag": "mixed-in-global",
      "listen": "127.0.0.1",
      "listen_port": 43210
    }
  ]
}