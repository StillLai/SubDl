{
  "$schema": "https://ghfast.top/https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      // "system_interface": true,
      "detour": "🔗 Tailscale",
      "auth_key": "",
      "control_url": "https://console.tailscale.com"
    }
  ],
  // "services": [
  //   {
  //     "type": "api",
  //     "listen": "::",
  //     "listen_port": 9999,
  //     "secret": "lyb0330",
  //     "dashboard": true
  //   }
  // ],
  "experimental": {
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://ghfast.top/https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      // "external_ui_download_detour": "🎈 自动选择",
      "secret": ""
    },
    "cache_file": {
      "enabled": true,
      // "path": "cache.db",
      "store_fakeip": true,
      "store_rdrc": true
    }
  }
}