{
  "$schema": "https://ghfast.top/https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "dns": {
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "servers": [
      {
        "tag": "DNS-Resolver",
        "type": "udp",
        "server": "119.29.29.29"
      },
      {
        "tag": "Tencent-DNS",
        "type": "tls",
        "server": "dot.pub",
        "domain_resolver": "DNS-Resolver"
      },
      {
        "tag": "Ali-DNS",
        "type": "h3",
        "server": "dns.alidns.com",
        "domain_resolver": "DNS-Resolver"
      },
      {
        "tag": "Google-DNS",
        "type": "h3",
        "server": "dns.google",
        "domain_resolver": "DNS-Resolver",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "Cloudflare-DNS",
        "type": "h3",
        "server": "1.1.1.1",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "DNS.SB",
        "type": "tls",
        "server": "dot.sb",
        "domain_resolver": "DNS-Resolver",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "Fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "Local-DNS",
        "type": "local"
      }
    ],
    "rules": [
      { // 直连模式
        "clash_mode": "Direct",
        "server": "Tencent-DNS"
      },
      { // 全局模式
        "type": "logical",
        "mode": "or",
        "rules": [
          {"clash_mode": "Global"},
          {"inbound": "mixed-in-global"}
        ],
        "server": "Google-DNS"
      },
      { // 广告拦截
        "type": "logical",
        "mode": "and",
        "rules": [
          {"clash_mode": "AlwAds", "invert": true},
          {"rule_set": ["custom_whitelist", "geosite-amazon", "geosite-amazon@ads"], "invert": true},
          {"rule_set": ["ads", "custom_block", "WebRTC"]}
        ],
        "action": "reject"
      },
      { // 银行APP（工商/建设/农业/中国/交通/招商）
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-icbc", "geosite-ccb", "geosite-abc", "geosite-boc", "BOCOM", "geosite-cmb"]},
          {"package_name": ["com.icbc", "com.chinamworld.main", "com.android.bankabc", "com.chinamworld.bocmbci", "com.bankcomm.Bankcomm", "com.cmbchina.ccd.pluto.cmbActivity", "cmb.pb"]}
        ],
        "server": "Tencent-DNS"
      },
      { // 加速器
        "rule_set": ["geosite-category-game-accelerator-cn"],
        "server": "Tencent-DNS"
      },
      { // 育碧
        "rule_set": ["geosite-ubisoft"],
        "server": "Cloudflare-DNS"
      },
      { // Steam
        "rule_set": ["geosite-steam"],
        "server": "Cloudflare-DNS"
      },
      { // Epic Games
        "rule_set": ["geosite-epicgames"],
        "server": "Cloudflare-DNS"
      },
      { // DNS测试
        "domain_suffix": ["browserleaks.com", "browserleaks.org", "browserleaks.net", "dnsleaktest.com"],
        "server": "DNS.SB"
      },
      // { // 亚马逊
