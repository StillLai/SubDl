{
  "$schema": "https://gh-proxy.org/https://github.com/jiang-zhexin/typebox/releases/latest/download/schema.json",
  "dns": {
    "strategy": "prefer_ipv4",
    "servers": [
      {
        "tag": "Local-DNS",
        "type": "local"
      },
      {
        "tag": "DNS-Resolver",
        "type": "udp",
        "server": "119.29.29.29"
      },
      {
        "tag": "Tencent-DNS",
        "type": "tls",
        "server": "dot.pub",
        "domain_resolver": "DNS-Resolver"
      },
      {
        "tag": "Ali-DNS",
        "type": "h3",
        "server": "dns.alidns.com",
        "domain_resolver": "DNS-Resolver"
      },
      {
        "tag": "Google-DNS",
        "type": "h3",
        "server": "dns.google",
        "domain_resolver": "DNS-Resolver",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "Cloudflare-DNS",
        "type": "h3",
        "server": "1.1.1.1",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "Tencent-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"clash_mode": "Global"},
          {"inbound": "mixed-in-global"}
        ],
        "server": "Google-DNS"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {"clash_mode": "AlwAds", "invert": true},
          {"rule_set": ["custom_whitelist", "geosite-amazon", "geosite-amazon@ads"], "invert": true},
          {"rule_set": ["ads", "custom_block", "WebRTC"]}
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-icbc", "geosite-ccb", "geosite-abc", "geosite-boc", "BOCOM", "geosite-cmb"]},
          {"package_name": ["com.icbc", "com.chinamworld.main", "com.android.bankabc", "com.chinamworld.bocmbci", "com.bankcomm.Bankcomm", "com.cmbchina.ccd.pluto.cmbActivity", "cmb.pb"]}
        ],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["geosite-amazon", "geosite-amazon@ads"],
        "server": "Cloudflare-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["WeChat"]},
          {"package_name": ["com.tencent.mm"]}
        ],
        "server": "Tencent-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["AliPay"]},
          {"package_name": ["com.eg.android.AlipayGphone"]}
        ],
        "server": "Ali-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["BiliBili"]},
          {"package_name": ["tv.danmaku.bili"]}
        ],
        "server": "Tencent-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-douyin"]},
          {"package_name": ["com.ss.android.ugc.aweme"]}
        ],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["Weibo"],
        "server": "Ali-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-xiaohongshu"]},
          {"package_name": ["com.xingin.xhs"]}
        ],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["geosite-steam"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-ubisoft"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-epicgames"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-github"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-youtube"],
        "server": "Google-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-netflix", "geoip-netflix"]},
          {"package_name": ["com.netflix.mediaclient"]}
        ],
        "server": "Cloudflare-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-tiktok"]},
          {"package_name": ["com.zhiliaoapp.musically"]}
        ],
        "server": "Cloudflare-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-spotify"]},
          {"package_name": ["com.spotify.music"]}
        ],
        "server": "Cloudflare-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-telegram", "geoip-telegram"]},
          {"package_name": ["nekox.messenger", "org.telegram.messenger", "tw.nekomimi.nekogram", "xyz.nextalone.nagram"]}
        ],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-twitter", "geoip-twitter"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-facebook", "geoip-facebook"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-discord"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-openai"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["XiaoMi"],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["Apple"],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["geosite-microsoft"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-cloudflare", "geoip-cloudflare"],
        "server": "Cloudflare-DNS"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {"rule_set": ["geosite-google", "geoip-google", "geosite-google-play"]},
          {"package_name": ["com.android.vending", "com.google.android.gms", "com.google.android.gsf", "com.google.android.onetimeinitializer"]}
        ],
        "server": "Google-DNS"
      },
      {
        "rule_set": ["geosite-geolocation-cn", "custom_direct"],
        "server": "Tencent-DNS"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {"rule_set": ["geosite-geolocation-!cn", "custom_proxy"], "invert": true},
          {"rule_set": "geoip-cn"}
        ],
        "server": "Tencent-DNS"
      },
      {
        "rule_set": ["geosite-geolocation-!cn", "custom_proxy"],
        "server": "Cloudflare-DNS"
      },
      {
        "rule_set": ["geosite-tld-cn", "GeositeCN", "geoip-cn"],
        "server": "Tencent-DNS"
      }
    ],
    "final": "Tencent-DNS"
  }
}